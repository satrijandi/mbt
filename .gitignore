# Python
__pycache__/
*.py[cod]
.venv/
# `uv build --all-packages` output (release.yml). No setuptools artifacts here:
# every package builds with hatchling, so .eggs/, build/ and *.egg-info/ never
# appear.
dist/

# Docs build output (mkdocs)
site/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
# COVERAGE_FILE=.coverage.<name> (CLAUDE.md's way of running two tiers without
# clobbering one data file) and coverage's own parallel-mode .coverage.<host>.
# <pid>.<random>; both are the same cache under an unpredictable name.
.coverage.*
htmlcov/

# mbt project artifacts, from running any in-tree project in place
# (tests/fixtures/{churn_demo,revenue_demo}, examples/showcase/project).
# Unanchored on purpose: the scoring configs write `predictions/<name>` and the
# profiles write `mlflow.db` relative to whichever project dir is running.
# The first six also appear in the repo-root conftest.py `_KNOWN_LITTER` guard,
# which fails a test run that drops them at the root; keep the two lists in step.
target/
mlruns/
mlartifacts/
mlflow.db
*.duckdb
*.duckdb.wal
predictions/

# JVM adapter leftovers (Spark/H2O e2e runs); also in conftest.py `_KNOWN_LITTER`
derby.log
metastore_db/
spark-warehouse/
h2ologs/
hs_err_pid*

# Local secrets / environment (live-Snowflake creds etc. flow via env vars;
# a root profiles.yml would be a dev's personal copy - example projects keep
# their tracked hermetic ones, and their tracked .env.example templates)
.env
.env.*
!.env.example
/profiles.yml

# Claude Code local state (shared config would be .claude/settings.json)
.claude/settings.local.json
.claude/*.lock

# Editors / OS
.vscode/
.idea/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
*.swp
