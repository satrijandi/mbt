# Snowflake credentials for mbt profiles and the live test suite.
#
# Copy to .env (gitignored - the repo ignores .env and .env.* everywhere)
# and load it into your shell before running mbt or the live suite:
#
#   set -a; source .env; set +a
#
# profiles.yml stays committed and secret-free: it references these via
# "{{ env_var('SNOWFLAKE_ACCOUNT') }}" etc. - never put values in YAML.

# -- required ----------------------------------------------------------------
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=me@example.com
SNOWFLAKE_WAREHOUSE=ML_WH
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_SCHEMA=SANDBOX          # live suite needs CREATE TABLE here

# -- auth: pick exactly one block ---------------------------------------------
# SSO through your browser (the usual data-scientist setup; the adapter
# caches the token via keyring - install mbt-snowflake[sso] - so one prompt
# covers the whole session):
SNOWFLAKE_AUTHENTICATOR=externalbrowser
# Password (new Snowflake accounts enforce MFA on these - prefer SSO/key-pair):
#SNOWFLAKE_PASSWORD=...
# Key-pair for CI and service users:
#SNOWFLAKE_PRIVATE_KEY_FILE=/path/to/rsa_key.p8
#SNOWFLAKE_PRIVATE_KEY_FILE_PWD=...

# -- optional -----------------------------------------------------------------
#SNOWFLAKE_ROLE=ML_ROLE

# The live suite's opt-in gate stays OUT of this file on purpose: exporting
# credentials must never be enough to trigger warehouse traffic or an SSO
# popup by itself. Opt in per invocation:
#   MBT_LIVE_SNOWFLAKE=1 uv run pytest -q -m live_snowflake
