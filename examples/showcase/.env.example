# Copy to .env next to the Makefile (or export in your shell) to override.
# Host ports (defaults avoid common dev-machine squatters):
#SHOWCASE_S3_PORT=8333
#SHOWCASE_FILER_PORT=8388
#SHOWCASE_MLFLOW_PORT=5501
#SHOWCASE_SPARK_UI_PORT=8380
#SHOWCASE_JUPYTER_PORT=8899
#SHOWCASE_PUSHGW_PORT=9491
#SHOWCASE_PROMETHEUS_PORT=9490
#SHOWCASE_GRAFANA_PORT=3390
#SHOWCASE_GITEA_PORT=3305
#SHOWCASE_WOODPECKER_PORT=8305
#SHOWCASE_WEBHOOK_PORT=9309
#SHOWCASE_ZOT_PORT=15000
#SHOWCASE_AIRFLOW_PORT=8280
# S3 credentials for the SeaweedFS stand-in (also baked into
# compose/seaweedfs/s3_config.json - change both together):
#SHOWCASE_S3_KEY=mbtadmin
#SHOWCASE_S3_SECRET=mbtsecret
# Where the shared /workspace bind mount lives on the host:
#SHOWCASE_WORKSPACE=~/.cache/mbt-showcase/workspace
# Runner image tag:
#SHOWCASE_RUNNER_IMAGE=mbt-showcase-runner:dev
# GID of the group owning /var/run/docker.sock as containers see it; the
# Makefile and test harness probe it (0 on Docker Desktop, the `docker`
# group on native Linux). Override only for remote/rootless daemons:
#DOCKER_SOCK_GID=0
# Compose project name (override to run a second stack side by side):
#SHOWCASE_PROJECT=mbt-showcase
